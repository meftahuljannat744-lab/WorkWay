PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workway

# Use a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Google OAuth 2.0 Web client ID used by Google Identity Services in the frontend.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Frontend origin/base URL. Password reset email links open /reset-password?token=...
APP_BASE_URL=http://localhost:3000

# Gmail SMTP: use a Google App Password, not your account password.
EMAIL_USER=you@example.com
EMAIL_APP_PASSWORD=your-google-app-password
